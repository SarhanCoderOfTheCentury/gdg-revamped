# Copy to .env.local; npm scripts load it using Node 22's native env-file support.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# PRIVATE: needed only on your workstation for cms:upload, NEVER prefixed VITE_/PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional PRIVATE Postgres connection string to create schema automatically.
# Use Supabase's Connect panel; URL-encode password characters. Omit after SQL Editor setup.
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=gdg-assets
# Browser-visible project token, not a PostHog personal access token.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Analytics is consent-based. Replay and form-text autocapture remain disabled.
# Optional Vercel Deploy Hook; used only by npm run cms:publish.
VERCEL_DEPLOY_HOOK=
